# JSON object: GitLab project path -> local checkout.
IMPL_REPOSITORIES='{}'

# Comma-separated directories inspected when a project has no explicit mapping.
IMPL_SEARCH_ROOTS='~/workspace'

# Run a Claude Code self-audit after every completed workflow.
IMPL_SELF_IMPROVEMENT_AUTORUN='false'

# Promote a validated self-improvement branch into the installed checkout. Nothing is pushed.
IMPL_SELF_IMPROVEMENT_AUTO_APPLY='false'

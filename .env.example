# JSON object: GitLab project path -> local checkout.
X_IMPLEMENT_REPOSITORIES='{}'

# Comma-separated directories inspected when a project has no explicit mapping.
X_IMPLEMENT_SEARCH_ROOTS='~/workspace'

# Run a Claude Code self-audit after every completed workflow.
X_IMPLEMENT_RSI_AUTORUN='false'

# Promote a validated RSI branch into the installed checkout. Nothing is pushed.
X_IMPLEMENT_RSI_AUTO_APPLY='false'

#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" = /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

repo_root="$(cd -P "$(dirname "$script_path")/.." && pwd)"
console_dir="$repo_root/console"
app_port="${IMPL_PORT:-3210}"
app_url="http://127.0.0.1:$app_port"
launch_url="$app_url"

program="$(basename "$0")"
command="${1:-}"

usage() {
  cat <<USAGE
Usage : $program [commande]

  (aucune)  démarre l'interface et ouvre le navigateur
  demo      démarre l'interface sur un scénario simulé, sans dépôt ni ticket
  restart   arrête le serveur en cours puis relance la version compilée
  stop      arrête le serveur en cours
  status    indique si un serveur écoute et s'il sert le build sur disque
  improve   traite les retours d'auto-amélioration avec Claude Code
  help      affiche cette aide

restart accepte le mode démo : $program restart demo

Variables d'environnement :
  IMPL_PORT      port d'écoute (défaut : $app_port)
  IMPL_NO_OPEN=1 ne pas ouvrir le navigateur

Codes de sortie de status : 0 en écoute et cohérent, 1 en écoute mais
incohérent, 3 arrêté.
USAGE
}

reject() {
  printf '%s\n\n' "$1" >&2
  usage >&2
  exit 1
}

case "$command" in
  help|--help|-h) usage; exit 0 ;;
  ""|demo|restart|stop|status|improve) ;;
  *) reject "Commande inconnue : $command" ;;
esac

if [[ "$command" != "restart" && $# -gt 1 ]]; then
  reject "Trop d'arguments : $*"
fi

if [[ "$command" == "improve" ]]; then
  mkdir -p "$console_dir/data/feedback/pending"
  cd "$repo_root"
  exec claude --plugin-dir "$repo_root" --name "implementation-harness self-improvement" "/implementation-harness:improve $console_dir/data/feedback"
fi

listening_pids() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -t -nP -iTCP:"$app_port" -sTCP:LISTEN 2>/dev/null || true
  else
    pgrep -f "tsx server/index.ts" 2>/dev/null || true
  fi
}

stop_server() {
  local pids
  pids="$(listening_pids)"
  if [[ -z "$pids" ]]; then
    printf 'Aucun serveur Implementation Harness en écoute sur le port %s.\n' "$app_port"
    return 0
  fi
  printf 'Arrêt du serveur Implementation Harness (PID %s)…\n' "$(echo $pids)"
  kill $pids 2>/dev/null || true
  for _ in {1..40}; do
    if [[ -z "$(listening_pids)" ]]; then
      return 0
    fi
    sleep 0.25
  done
  printf 'Arrêt forcé.\n'
  kill -9 $(listening_pids) 2>/dev/null || true
  sleep 0.5
  if [[ -n "$(listening_pids)" ]]; then
    printf 'Le port %s reste occupé. Libère-le manuellement avant de relancer.\n' "$app_port" >&2
    exit 1
  fi
}

if [[ "$command" == "stop" ]]; then
  stop_server
  exit 0
fi

# Le serveur en cours sert le manifeste Next.js du build present a son
# demarrage. Apres une recompilation, ses feuilles de style pointent vers des
# fichiers effaces : la page s'affiche sans style. On verifie donc les
# ressources reellement servies, pas seulement la presence d'un processus.
status_report() {
  local pids
  pids="$(listening_pids)"
  if [[ -z "$pids" ]]; then
    printf 'Arrêté. Aucun serveur en écoute sur le port %s.\n' "$app_port"
    return 3
  fi
  printf 'Serveur   : en écoute sur %s (PID %s)\n' "$app_url" "$(echo $pids)"

  local build_id="(inconnu)"
  if [[ -f "$console_dir/.next/BUILD_ID" ]]; then
    build_id="$(cat "$console_dir/.next/BUILD_ID")"
  fi
  printf 'Build     : %s sur disque\n' "$build_id"

  if ! command -v curl >/dev/null 2>&1; then
    printf 'Ressources: non vérifiées, curl est absent.\n'
    return 0
  fi

  if ! curl -fsS "$app_url/api/state" 2>/dev/null | grep -q '"state"'; then
    printf 'API       : /api/state ne répond pas comme le harnais.\n' >&2
    printf 'Un autre programme occupe peut-être le port %s.\n' "$app_port" >&2
    return 1
  fi
  printf 'API       : répond\n'

  local page assets missing=0 total=0 asset
  page="$(curl -fsS "$app_url/" 2>/dev/null || true)"
  assets="$(printf '%s' "$page" | grep -o '/_next/static/[^"\\]*' | sort -u || true)"
  if [[ -z "$assets" ]]; then
    printf 'Ressources: aucune ressource référencée, rien à vérifier.\n'
    return 0
  fi
  while IFS= read -r asset; do
    total=$((total + 1))
    if [[ "$(curl -s -o /dev/null -w '%{http_code}' "$app_url$asset")" != "200" ]]; then
      missing=$((missing + 1))
    fi
  done <<< "$assets"

  if (( missing > 0 )); then
    printf 'Ressources: %s sur %s introuvable(s).\n' "$missing" "$total" >&2
    printf 'Le serveur sert un build plus ancien que celui sur disque.\n' >&2
    printf 'Relance-le : %s restart\n' "$program" >&2
    return 1
  fi
  printf 'Ressources: %s servies, build à jour\n' "$total"
  return 0
}

if [[ "$command" == "status" ]]; then
  set +e
  status_report
  exit $?
fi

if [[ "$command" == "restart" ]]; then
  shift
  command="${1:-}"
  case "$command" in
    ""|demo) ;;
    *) reject "restart n'accepte que le mode démo, reçu : $command" ;;
  esac
  if [[ $# -gt 1 ]]; then
    reject "Trop d'arguments : $*"
  fi
  stop_server
fi

if [[ "$command" == "demo" ]]; then
  launch_url="$app_url/?demo=1"
fi

open_app() {
  if [[ "${IMPL_NO_OPEN:-0}" == "1" ]]; then return; fi
  if command -v open >/dev/null 2>&1; then
    open "$launch_url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$launch_url" >/dev/null 2>&1
  fi
}

if command -v curl >/dev/null 2>&1 && curl -fsS "$app_url/api/state" >/dev/null 2>&1; then
  open_app
  printf 'Implementation Harness est déjà disponible sur %s\n' "$app_url"
  exit 0
fi

(
  for _ in {1..40}; do
    if command -v curl >/dev/null 2>&1 && curl -fsS "$app_url/api/state" >/dev/null 2>&1; then
      open_app
      exit 0
    fi
    sleep 0.25
  done
) &

cd "$console_dir"
PORT="$app_port" exec npm run start

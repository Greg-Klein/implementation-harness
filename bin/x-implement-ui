#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" = /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

repo_root="$(cd -P "$(dirname "$script_path")/.." && pwd)"
harness_dir="$repo_root/harness"
app_port="${X_IMPLEMENT_PORT:-3210}"
app_url="http://127.0.0.1:$app_port"
launch_url="$app_url"

if [[ "${1:-}" == "improve" ]]; then
  mkdir -p "$harness_dir/data/feedback/pending"
  cd "$repo_root"
  exec claude --plugin-dir "$repo_root" --name "x-implement RSI" "/x-implement:x-improve $harness_dir/data/feedback"
fi

if [[ "${1:-}" == "demo" ]]; then
  launch_url="$app_url/?demo=1"
fi

open_app() {
  if [[ "${X_IMPLEMENT_NO_OPEN:-0}" == "1" ]]; then return; fi
  if command -v open >/dev/null 2>&1; then
    open "$launch_url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$launch_url" >/dev/null 2>&1
  fi
}

if command -v curl >/dev/null 2>&1 && curl -fsS "$app_url/api/state" >/dev/null 2>&1; then
  open_app
  printf 'X-Implement est déjà disponible sur %s\n' "$app_url"
  exit 0
fi

(
  for _ in {1..40}; do
    if command -v curl >/dev/null 2>&1 && curl -fsS "$app_url/api/state" >/dev/null 2>&1; then
      open_app
      exit 0
    fi
    sleep 0.25
  done
) &

cd "$harness_dir"
PORT="$app_port" exec npm run start
